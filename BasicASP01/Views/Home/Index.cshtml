@{
    ViewData["Title"] = "Home Page";
}

<div class="row align-items-center py-5 my-4">
    <!-- ฝั่งซ้าย: ข้อความต้อนรับและปุ่มหลัก -->
    <div class="col-lg-7 mb-4 mb-lg-0">
       
        <h1 class="display-4 fw-bold text-dark mb-3">Welcome</h1>
        <p class="fs-5 text-secondary mb-4">
            นี้คือหน้าแรกของแอพพิเคชันของเรา สามารถเลือกดูรายการสินค้าหรือตรวจสอบข้อมูลระบบได้จากเมนูด้านล่าง
        </p>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg px-4">
                ดูรายการสินค้า
            </a>
            <a asp-controller="Home" asp-action="About" class="btn btn-light border btn-lg px-4">
                เกี่ยวกับเรา
            </a>
        </div>
    </div>
